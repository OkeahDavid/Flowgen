# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security Configuration
# Demo token for protecting API endpoints (generate a random string)
# Leave empty for local development, MUST set for production
DEMO_TOKEN=

# CORS Configuration
# Comma-separated list of allowed origins
# Production Netlify URL included
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://flowgen-ai.netlify.app